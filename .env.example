# Salin menjadi .env.local di VPS lalu isi nilainya. JANGAN di-commit ke GitHub.

# Supabase project "emki-training" → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-atau-publishable-key
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-atau-secret-key

# Kunci enkripsi password SIAPkerja (buat dengan: openssl rand -base64 32)
# JANGAN diganti setelah ada data, karena password lama tidak bisa dibuka lagi.
SIAPKERJA_ENC_KEY=isi-hasil-openssl

# Alamat aplikasi
NEXT_PUBLIC_SITE_URL=https://training.edukasikuliner.com
NEXT_PUBLIC_WA_ADMIN=6285117575842
